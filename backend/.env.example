# Database. Defaults to a local SQLite file (repo-root macros.db) when unset.
# Production (Neon): postgresql+psycopg://USER:PASSWORD@HOST/DB?sslmode=require
DATABASE_URL=

# Secret for signing JWT access tokens. REQUIRED in production (any non-SQLite
# database refuses to start without it). Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# Access token lifetime in days (default 7).
ACCESS_TOKEN_DAYS=7

# Gemini API key for AI meal analysis. Feature returns 503 when unset.
GEMINI_API_KEY=

# Gemini model for meal analysis. Overrides the in-code default, so a retired
# model can be swapped without a deploy. Google retires models on a schedule —
# check https://ai.google.dev/gemini-api/docs/models before pinning.
MEAL_AI_MODEL=gemini-3.5-flash

# Model tried when the one above returns 5xx on every attempt (default
# gemini-2.5-flash). Overload is per serving pool, so an older generation is
# usually still answering. Set empty to disable the fallback.
MEAL_AI_FALLBACK_MODEL=gemini-2.5-flash

# Seconds one analysis may keep retrying a busy provider before giving up
# (default 60). Retries alternate between the two models above with jittered
# exponential backoff, and apply only to 5xx and transport failures — never to
# 429s, where retrying makes the rate limit worse. Gemini's overload 503 comes
# back in ~150ms, so the budget is spent waiting, not calling: 60s buys roughly
# a dozen attempts. Keep the frontend's request timeout above this.
MEAL_AI_DEADLINE_S=60

# Per-user daily cap on GET /api/ai/status?probe=true (default 10), which spends
# one real provider call. Results are cached 60s process-wide.
AI_PROBE_DAILY_LIMIT=10

# When non-empty, /api/ai/status?probe=true includes the provider's own error
# text (truncated to 300 chars). Off by default because signup is open; turn it
# on while diagnosing, then off again. See docs/runbook-ai-provider.md.
MEAL_AI_STATUS_DETAIL=

# Per-user daily cap on AI analyses (default 20). Protects the shared Gemini quota.
AI_DAILY_LIMIT=20

# Per-user daily cap on voice-note transcriptions (default 40). Separate from
# AI_DAILY_LIMIT so speaking a meal doesn't cost twice what typing it does.
AI_TRANSCRIBE_DAILY_LIMIT=40

# Ceiling on AI calls per day across ALL users and both kinds (default 500).
# The per-user caps bound one account; this bounds the app, so mass signups
# can't drain the free quota or run up a bill on a paid key. Keep it below your
# provider's daily allowance (Gemini's free tier is ~1500/day).
AI_GLOBAL_DAILY_LIMIT=500

# Comma-separated allowed CORS origins (default: local Vite dev server).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Password reset email (Brevo) ------------------------------------------
# Brevo API key. Password reset returns 503 when this or the sender address is
# unset — for every address alike, so an unconfigured server can't be used to
# tell which emails have accounts.
BREVO_API_KEY=

# The "From" address. Must be a sender you have verified in the Brevo dashboard
# (add it, then enter the 6-digit code Brevo emails you); an unverified address
# is rejected with a 400 on every send.
#
# Note what recipients actually see: Brevo rewrites the From domain to
# @brevosend.com whenever the sending domain isn't authenticated, and a free
# provider domain (gmail.com and friends) cannot be authenticated at all. Mail
# still delivers, but it looks like it came from a stranger — which is why the
# app name leads the subject and body, and why the frontend warns about it. To
# fix it properly, buy a domain, authenticate it in Brevo, and change this
# value; no code changes.
EMAIL_SENDER_ADDRESS=

# Display name beside that address (default "Macros Calculator"). Doing real
# work while the address above is being rewritten.
EMAIL_SENDER_NAME=Macros Calculator

# Origin of the deployed frontend, used to build the emailed reset link.
# NEVER derived from the request's Host header: that is host-header injection,
# and it would mail a victim a real reset link pointing at an attacker's site.
# Defaults in code to the production Vercel URL, so an unset value still
# produces a working link rather than a localhost one.
APP_BASE_URL=http://localhost:5173

# How long a reset link stays valid, in minutes (default 60). Not shorter
# without good reason: an unauthenticated sender is routinely greylisted for
# 5-15 minutes by receiving mail servers, so a "tidy" 15-minute expiry can lapse
# before the message is even readable.
PASSWORD_RESET_TTL_MINUTES=60

# Ceiling on reset emails per day across ALL users (default 100). The per-IP
# limit bounds one caller; this bounds the app, so nobody can drain the free
# tier's 300/day allowance and leave genuine reset requests unanswered.
PASSWORD_RESET_GLOBAL_DAILY_LIMIT=100

# Site-wide notice shown at the top of every page, and on the login page. Read
# on every request, so an outage can be announced from the hosting dashboard
# without a deploy — clear it to remove the banner. Release notes are committed
# in app/announcements.py instead; this is for "AI analysis is down right now".
STATUS_BANNER=
