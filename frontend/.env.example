# Base URL of the FastAPI backend. Leave empty in local dev — the Vite dev
# server proxies /api to http://localhost:8000 (see vite.config.ts).
# In production (Vercel), set this to your Render backend URL, e.g.
# VITE_API_URL=https://macros-calculator-api-us.onrender.com
# (the original macros-calculator-api host was retired and now 404s;
#  frontend/vercel.json's CSP connect-src is the in-repo source of truth)
VITE_API_URL=
